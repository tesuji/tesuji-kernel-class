#!/bin/bash
set -e
export PATH=/bin

passwd -d hacker
#mv /dev/kvm /dev/nokvm

pushd /challenge
mkdir -p /src
cp echo.c Makefile /src
cd /src
make CC=/bin/gcc
cp /src/echo.ko /challenge/
popd

find /challenge -type f -exec chmod 444 {} +
chmod 4755 /challenge/bin/vm
chmod 0755 /challenge/vm_init

/lib/modules/6.8.0-83-generic/build/scripts/extract-vmlinux \
	/challenge/bzImage > /challenge/vmlinux

